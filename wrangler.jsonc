{
  // Cloudflare Worker for invariancetech.info: static files from this repository,
  // plus worker/index.js for /api/substack (the Dispatches feed) and the 404 page.
  "name": "tia-website",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash"
  }
}
